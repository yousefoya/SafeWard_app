<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp"
              android:background="@drawable/bg_security_card"
              android:orientation="vertical"
              android:padding="16dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/attackTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="CROSS_LAYER_SPOOF"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="11sp"
                android:textStyle="bold" />

        <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        <TextView
                android:id="@+id/actionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="BLOCKED"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
    </LinearLayout>

    <TextView
            android:id="@+id/roomAndSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Room 101 • UNKNOWN_NODE_99"
            android:textColor="@color/text_soft_charcoal"
            android:textSize="15sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="Fake fall alert rejected: physical Wi-Fi CSI shows empty/still room"
            android:textColor="@color/text_muted_slate"
            android:textSize="13sp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/timestampText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2026-11-27 12:15:03"
                android:textColor="@color/text_muted_slate"
                android:textSize="12sp" />

        <TextView
                android:id="@+id/logIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="sec_01"
                android:textColor="@color/text_muted_slate"
                android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
