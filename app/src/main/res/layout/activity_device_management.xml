<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cloud_cream"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.patient.DeviceManagementActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Devices &amp; Rooms"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP32 Nodes, Sensors &amp; Room Setup"
                android:textColor="@color/text_muted_slate"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/patientProfileButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/text_soft_charcoal"
            android:text="Patients"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/surface_warm_linen"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/text_soft_charcoal"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Summary Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_banner"
            android:backgroundTint="@color/csi_soft_sky_mist"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Nodes"
                android:textColor="@color/text_muted_slate"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/totalNodesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_banner"
            android:backgroundTint="@color/status_safe_mint"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="@color/text_muted_slate"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/onlineNodesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_status_banner"
            android:backgroundTint="@color/security_soft_lavender"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TLS Verified"
                android:textColor="@color/text_muted_slate"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tlsNodesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_rounded"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="All"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterCsi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_rounded"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="Wi-Fi CSI"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterMed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_rounded"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="Sensors"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterOffline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_rounded"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="Offline"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Node List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/devicesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/emptyDevicesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No devices match this filter."
        android:textColor="@color/text_muted_slate"
        android:visibility="gone" />

    <Button
        android:id="@+id/addRoomButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/text_soft_charcoal"
        android:paddingVertical="12dp"
        android:text="+ Add New Room &amp; ESP32 Node"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold" />
</LinearLayout>
