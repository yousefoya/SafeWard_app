<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cloud_cream"
    android:padding="16dp"
    tools:context=".ui.patient.PatientProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Profile"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vitals &amp; Live Bio-Chart"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/devicesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/text_soft_charcoal"
                android:text="Devices"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_warm_linen"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Room / Patient Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_security_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Patient:"
                android:textColor="@color/text_muted_slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/roomSpinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Patient Identity & CSI Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_security_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/patientNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ahmad Al-Masri"
                        android:textColor="@color/text_soft_charcoal"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/patientMetaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Room 101 • Age 72"
                        android:textColor="@color/text_muted_slate"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/csiStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_rounded"
                    android:backgroundTint="@color/status_safe_mint"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="NORMAL"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/fallConfidenceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wi-Fi CSI Fall Confidence: 4% • Updated 12:28"
                android:textColor="@color/text_muted_slate"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2x2 Vitals Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_banner"
                android:backgroundTint="@color/vitals_blush_petal"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heart Rate"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/heartRateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="74 bpm"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_banner"
                android:backgroundTint="@color/csi_soft_sky_mist"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SpO2 (MAX30102)"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/spo2Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="98 %"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_banner"
                android:backgroundTint="@color/alert_warning_amber"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperature"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tempValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="36.7 °C"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_banner"
                android:backgroundTint="@color/status_safe_mint"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breathing Rate"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/breathingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="16 rpm"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vital Signs Chart Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_security_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/chartTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vital Signs Trend"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Metric Selector Pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/metricHr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_rounded"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:text="HR"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/metricSpo2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_rounded"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:text="SpO2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/metricTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_rounded"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:text="Temp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/metricBr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_rounded"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:text="Breath"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.safeward.ui.patient.VitalSignsChartView
                android:id="@+id/vitalChartView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Recent Room Events (Week 1 Preview for History Log) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_security_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Room Events"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recentEventsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No recorded events for this room."
                android:textColor="@color/text_muted_slate"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
