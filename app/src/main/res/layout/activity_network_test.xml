<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/main"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/bg_cloud_cream"
              android:orientation="vertical"
              android:padding="24dp"
              tools:context=".NetworkTestActivity">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Network Layer Test"
            android:textColor="@color/text_soft_charcoal"
            android:textSize="24sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/sessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted_slate"
            android:textSize="14sp" />

    <TextView
            android:id="@+id/stateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/security_soft_lavender"
            android:padding="12dp"
            android:text="DISCONNECTED"
            android:textColor="@color/text_soft_charcoal"
            android:textStyle="bold" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@color/surface_white">

        <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/text_soft_charcoal"
                android:textIsSelectable="true"
                android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

        <Button
                android:id="@+id/reconnectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/text_soft_charcoal"
                android:text="Reconnect"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        <Button
                android:id="@+id/logoutButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/alert_critical_rose"
                android:text="Log out"
                android:textAllCaps="false"
                android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
