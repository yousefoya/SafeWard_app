<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/main"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/bg_cloud_cream"
              android:orientation="vertical"
              android:padding="20dp"
              tools:context=".ui.security.SecurityAuditActivity">

    <!-- Header -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security Audit Log"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/officerSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Security Officer • SafeWard"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="13sp" />
        </LinearLayout>

        <Button
                android:id="@+id/logoutButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/surface_warm_linen"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="Log out"
                android:textAllCaps="false"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="13sp" />
    </LinearLayout>

    <!-- Live Protection Banner -->
    <LinearLayout
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_banner"
            android:orientation="vertical"
            android:padding="12dp">

        <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting to telemetry stream…"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="13sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/tlsNodesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verifying ESP32 TLS nodes…"
                android:textColor="@color/text_muted_slate"
                android:textSize="12sp" />
    </LinearLayout>

    <!-- KPI Summary Cards -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_rounded"
                android:backgroundTint="@color/vitals_blush_petal"
                android:orientation="vertical"
                android:padding="12dp">

            <TextView
                    android:id="@+id/totalEventsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blocked"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_rounded"
                android:backgroundTint="@color/alert_warning_amber"
                android:orientation="vertical"
                android:padding="12dp">

            <TextView
                    android:id="@+id/replayCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Replay"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_rounded"
                android:backgroundTint="@color/security_soft_lavender"
                android:orientation="vertical"
                android:padding="12dp">

            <TextView
                    android:id="@+id/spoofCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spoof / Auth"
                    android:textColor="@color/text_muted_slate"
                    android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_rounded"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="All"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/filterSpoof"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_rounded"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Cross-Layer Spoof"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="13sp" />

            <TextView
                    android:id="@+id/filterReplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_rounded"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Replay Attack"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="13sp" />

            <TextView
                    android:id="@+id/filterUnauthorized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_rounded"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Unauthorized"
                    android:textColor="@color/text_soft_charcoal"
                    android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Live Feed List -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/securityRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No security anomalies recorded for this filter."
            android:textColor="@color/text_muted_slate"
            android:textSize="14sp"
            android:visibility="gone" />

    <!-- Bottom Actions -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <Button
                android:id="@+id/refreshButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/text_soft_charcoal"
                android:text="Refresh Feed"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        <Button
                android:id="@+id/networkTestButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/csi_soft_sky_mist"
                android:text="Network Log"
                android:textAllCaps="false"
                android:textColor="@color/text_soft_charcoal" />
    </LinearLayout>

</LinearLayout>
