<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_security_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/deviceIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP32_CSI_101"
                android:textColor="@color/text_soft_charcoal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceTypeRoomText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Wi-Fi CSI Node • Room 101"
                android:textColor="@color/text_muted_slate"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/deviceStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_rounded"
            android:backgroundTint="@color/status_safe_mint"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ONLINE"
            android:textColor="@color/text_soft_charcoal"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rssiText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Signal: -48 dBm (Strong)"
            android:textColor="@color/text_muted_slate"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tlsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill_rounded"
            android:backgroundTint="@color/csi_soft_sky_mist"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="TLS OK"
            android:textColor="@color/text_soft_charcoal"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lastSeenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:29"
            android:textColor="@color/text_muted_slate"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
